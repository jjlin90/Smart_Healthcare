APP_NAME=MedAgent AI
SECRET_KEY=
DATABASE_URL=mysql+aiomysql://medagent:YOUR_PASSWORD@127.0.0.1:3306/medagent?charset=utf8mb4
MYSQL_DATABASE=medagent
MYSQL_USER=medagent
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# SiliconFlow 主 Agent（用户指定）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 本地 LM Studio 意图分类模型（OpenAI 兼容接口）
LOCAL_INTENT_API_KEY=lm-studio
LOCAL_INTENT_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_INTENT_MODEL=qwen/qwen3.5-9b

# MCP 与三个 A2A Agent 服务地址
MCP_SERVER_URL=http://127.0.0.1:8002/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8002
SYMPTOM_AGENT_URL=http://127.0.0.1:8011
DRUG_AGENT_URL=http://127.0.0.1:8012
GUIDE_AGENT_URL=http://127.0.0.1:8013

# 医院系统真实接口（不要提交真实密钥）
DRUG_API_BASE_URL=
GUIDELINE_API_BASE_URL=
LIS_API_BASE_URL=
EMR_API_BASE_URL=
HIS_API_BASE_URL=
HOSPITAL_APP_KEY=
HOSPITAL_APP_SECRET=

# 短信验证码服务
SMS_VERIFY_API_URL=
SMS_APP_KEY=
SMS_APP_SECRET=

SESSION_TTL_SECONDS=1800
REDIS_URL=redis://127.0.0.1:6379/0
CHECKPOINT_TTL_SECONDS=86400
EXTERNAL_REQUEST_TIMEOUT=10
AGENT_MAX_ITERATIONS=6

# LangSmith（追踪中隐藏患者原文和医疗答复）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=medagent-ai
GRAFANA_ADMIN_PASSWORD=
