APP_NAME=MedAgent AI
SECRET_KEY=
DATABASE_URL=mysql+aiomysql://medagent:YOUR_PASSWORD@127.0.0.1:3306/medagent?charset=utf8mb4
MYSQL_DATABASE=medagent
MYSQL_USER=medagent
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# SiliconFlow 主 Agent（用户指定）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# 四级意图识别：正则 -> 医疗 BERT -> 向量语义相似度 -> SiliconFlow 大模型兜底
# BERT 必须是本项目当前纯 ToB 十类意图微调后的目录，不能填写通用模型或旧患者侧分类模型。
INTENT_BERT_MODEL_PATH=
INTENT_BERT_THRESHOLD=0.95
# 推荐填写本机 BGE-M3 / SentenceTransformer 模型目录。
INTENT_VECTOR_MODEL_PATH=
INTENT_VECTOR_THRESHOLD=0.78
INTENT_VECTOR_MARGIN=0.04
INTENT_PROTOTYPES_PATH=evaluation/intent_prototypes.jsonl

# MCP 与三个 A2A Agent 服务地址
MCP_SERVER_URL=http://127.0.0.1:8002/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8002
SYMPTOM_AGENT_URL=http://127.0.0.1:8011
DRUG_AGENT_URL=http://127.0.0.1:8012
GUIDE_AGENT_URL=http://127.0.0.1:8013

# 医院系统真实接口（不要提交真实密钥）
DRUG_API_BASE_URL=
GUIDELINE_API_BASE_URL=
LIS_API_BASE_URL=
EMR_API_BASE_URL=
HIS_API_BASE_URL=
HOSPITAL_APP_KEY=
HOSPITAL_APP_SECRET=

SESSION_TTL_SECONDS=1800
# 本地开发可留空以使用进程内 TTLCache；多实例部署时填写 Redis 地址。
REDIS_URL=
CHECKPOINT_TTL_SECONDS=86400
EXTERNAL_REQUEST_TIMEOUT=10
AGENT_MAX_ITERATIONS=6

# LangSmith（追踪中隐藏患者原文和医疗答复）
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=medagent-ai
GRAFANA_ADMIN_PASSWORD=
